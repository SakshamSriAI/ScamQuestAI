# ScamQuest Root Environment Example
# Copy to backend/.env or configure in your environment

# Google GenAI API Key (Get yours from https://aistudio.google.com/)
# Optional for local demo; engine engages curated fallback scenarios if empty.
GEMINI_API_KEY=""

# Gemini Model Identifier (Must not use deprecated Gemini 1.5 Flash)
GEMINI_MODEL="gemini-2.5-flash"

# Security & Performance Parameters
MAX_SCAN_INPUT_LENGTH="1000"
API_TIMEOUT_SECONDS="10.0"

# CORS Allowed Origins (Comma-separated or * for public access)
CORS_ORIGINS="*"

# Frontend API Base URL (leave blank for local Vite proxy /api -> localhost:8000)
VITE_API_BASE_URL=""
